{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bed-tracker",
  "compatibility_date": "2026-08-21",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  }
}